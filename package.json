{
  "name": "dsh-plugin-skill2cn",
  "version": "0.2.0",
  "description": "Skill2CN · 技能汉化 — translate DSH skill descriptions to Simplified Chinese",
  "license": "MIT",
  "author": {
    "name": "kaluosifa",
    "email": "17607149859@163.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaluosifa/dsh-plugin-skill2cn.git"
  },
  "homepage": "https://github.com/kaluosifa/dsh-plugin-skill2cn#readme",
  "bugs": {
    "url": "https://github.com/kaluosifa/dsh-plugin-skill2cn/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "skill",
    "i18n",
    "translation",
    "chinese"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "dev": "tsc -p tsconfig.build.json && tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "3.18.3",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-skill": "0.1.7-alpha.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  }
}
